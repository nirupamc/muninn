# Munin environment configuration
MUNIN_ENV=development
DATABASE_URL=sqlite:///./data/munin.db
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# M1 — Semantic Retrieval
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
# Fail clearly instead of downloading when the configured model is not cached.
EMBEDDING_LOCAL_FILES_ONLY=false

# M2 — Memory Admission
ADMISSION_PROVIDER=deterministic
ADMISSION_STORE_THRESHOLD=0.65
ADMISSION_MIN_CONFIDENCE=0.60
ADMISSION_BASE_URL=
ADMISSION_MODEL=
ADMISSION_API_KEY=

# M3 — Deduplication & Reinforcement
DEDUP_PROVIDER=deterministic
DEDUP_CANDIDATE_LIMIT=5
DEDUP_MIN_SIMILARITY=0.55
DEDUP_RELATIONSHIP_MIN_CONFIDENCE=0.70
DEDUP_BASE_URL=
DEDUP_MODEL=
DEDUP_API_KEY=

# M4 — Contradiction + Temporal Memory
TEMPORAL_PROVIDER=deterministic
TEMPORAL_CANDIDATE_LIMIT=5
TEMPORAL_MIN_SIMILARITY=0.50
TEMPORAL_RELATIONSHIP_MIN_CONFIDENCE=0.75
TEMPORAL_BASE_URL=
TEMPORAL_MODEL=
TEMPORAL_API_KEY=

# M5 — Context Assembly
CONTEXT_MAX_CANDIDATES=50
CONTEXT_DEFAULT_MAX_MEMORIES=20
CONTEXT_WEIGHT_SEMANTIC=0.45
CONTEXT_WEIGHT_IMPORTANCE=0.20
CONTEXT_WEIGHT_CONFIDENCE=0.10
CONTEXT_WEIGHT_RECENCY=0.10
CONTEXT_WEIGHT_TYPE_RELEVANCE=0.10
CONTEXT_WEIGHT_REINFORCEMENT=0.05
CONTEXT_REDUNDANCY_THRESHOLD=0.85
CONTEXT_DEFAULT_TOKEN_BUDGET=1500
CONTEXT_MAX_TOKEN_BUDGET=20000
CONTEXT_RECENCY_LAMBDA=0.05

# M6 — Decay (experimental — lambdas are per-day exponential decay rates)
DECAY_ENABLED=true
DECAY_LAMBDA_NONE=0.0
DECAY_LAMBDA_SLOW=0.002
DECAY_LAMBDA_NORMAL=0.01
DECAY_LAMBDA_FAST=0.05
DECAY_LAMBDA_EPHEMERAL=0.20

# M6 — Consolidation
CONSOLIDATION_PROVIDER=deterministic
CONSOLIDATION_MIN_GROUP_SIZE=3
CONSOLIDATION_MAX_GROUP_SIZE=10
CONSOLIDATION_MIN_SIMILARITY=0.60
CONSOLIDATION_MIN_CONFIDENCE=0.75
CONSOLIDATION_BASE_URL=
CONSOLIDATION_MODEL=
CONSOLIDATION_API_KEY=

# M8 — Universal Project Discovery & Memory Capture
# Semicolon-separated workspace roots to scan for projects (e.g., "E:\;D:\Projects")
MUNIN_WORKSPACE_ROOTS=
# Enable/disable capture globally
CAPTURE_ENABLED=true
# Enable/disable filesystem change capture
CAPTURE_FILESYSTEM_ENABLED=true
# Enable/disable Git commit capture
CAPTURE_GIT_ENABLED=true
# Activity window in minutes for "active" project status
CAPTURE_ACTIVITY_WINDOW_MINUTES=60
# Debounce window in seconds for filesystem batch capture
CAPTURE_FILESYSTEM_DEBOUNCE_SECONDS=30
# Comma-separated paths to exclude from filesystem capture
CAPTURE_EXCLUDED_PATHS=.git,node_modules,.venv,venv,dist,build,__pycache__,AppData,Local,Temp,tmp,cache,.cache,.env,.env.*,id_rsa,id_ed25519,id_ecdsa,credentials.json,secrets.json,config.json
